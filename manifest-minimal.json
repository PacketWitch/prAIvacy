{
  "manifest_version": 3,
  "name": "prAIvacy Ad Blocker - MINIMAL",
  "description": "Minimal working version for troubleshooting",
  "version": "3.0.2",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background-minimal.js"
  },
  "action": {
    "default_title": "Open prAIvacy MINIMAL"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}